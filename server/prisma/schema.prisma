generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

generator dbml {
  provider = "prisma-dbml-generator"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User { 
  id         String     @id @default(uuid()) 
  cnpj       String     @unique              
  email      String     @unique
  password   String
  telefone   String?

  ong        ONG?
  empresa    Empresa?
  prefeitura Prefeitura?
}

model ONG {
  id              String   @id @default(uuid()) 
  ods             String?
  userId          String   @unique @map("usuarioId") 
  user            User     @relation(fields: [userId], references: [id]) 

  apoiosRecebidos Apoio[]
}

model Empresa {
  id                                 String    @id @default(uuid()) 
  userId                             String    @unique @map("usuarioId") 
  user                               User      @relation(fields: [userId], references: [id]) 

  quantidadeAcoesConscientizacao     Int?      @map("quantidade_acoes_conscientizacao")
  quantidadeODSAtuacao               Int?      @map("quantidade_ods_atuacao")
  quantidadeONGsAtingidas            Int?      @map("quantidade_ongs_atingidas")
  porcentagemColaboradoresEngajados  Float?    @map("porcentagem_colaboradores_engajados")
  porcentagemOrcamentoVoluntariado   Float?    @map("porcentagem_orcamento_voluntariado")

  apoios                             Apoio[]
  criterios                          Criterio[]
}

model Prefeitura {
  id         String   @id @default(uuid()) 
  nome       String
  userId     String   @unique @map("usuarioId") 
  user       User     @relation(fields: [userId], references: [id])

  apoios     Apoio[]
}

model Apoio {
  id           String      @id @default(uuid())
  data         DateTime
  valor        Float
  tipoAjuda    String
  documentacao String

  empresaId    String      
  ongId        String      
  prefeituraId String?
  empresa      Empresa     @relation(fields: [empresaId], references: [id])
  ong          ONG         @relation(fields: [ongId], references: [id])
  prefeitura   Prefeitura? @relation(fields: [prefeituraId], references: [id])
}

model Criterio {
  id         String  @id @default(uuid())
  tipo       String
  pontuacao  Int

  empresaId  String 
  seloId     String 

  empresa    Empresa @relation(fields: [empresaId], references: [id])
  selo       Selo    @relation(fields: [seloId], references: [id])
}

model Selo {
  id         String   @id @default(uuid()) 
  tipo       String
  tier       String

  criterios  Criterio[]
}